# ClauseCompass Environment Configuration

# Google Gemini API Key (optional in DEMO_MODE)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Demo mode flag: If true or if GEMINI_API_KEY is empty, the app runs in offline demo mode
# using high-fidelity deterministic responses for sample docs and heuristic fallback.
DEMO_MODE=true

# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Security & Ingestion Limits
MAX_FILE_SIZE_MB=5
MAX_PAGES=60
RATE_LIMIT_PER_MINUTE=60
CACHE_SIZE_ITEMS=100
